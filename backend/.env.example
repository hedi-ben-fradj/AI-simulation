# Copy to backend/.env and edit. `python -m aisim` (and ./run.sh) read it automatically.
# Never commit the real file.

# Database. Leave unset to use a local SQLite file (backend/aisim.db) - fine for
# personal use. For PostgreSQL, uncomment and adjust:
# DATABASE_URL=postgresql+psycopg://aisim:aisim@localhost:5432/aisim

# Needed only for LLM-driven agents when no key is typed on the setup page.
# Backend-only: never exposed to the browser.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Claude subscription mode: which `claude` executable to run (default: the one on PATH),
# where its per-world session folders go, and extra CLI arguments.
# AISIM_CLAUDE_PATH=/usr/local/bin/claude
# AISIM_CLAUDE_WORKDIR=~/.cache/aisim/claude-code
# AISIM_CLAUDE_EXTRA_ARGS=

# Restart worlds that were running when the server stopped.
AISIM_AUTO_RESUME=false

# Optional bearer token required for changes through the API.
# AISIM_API_TOKEN=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
