# Copy to .env (never commit real secrets).
DATABASE_URL=postgresql+psycopg://aisim:aisim@localhost:5432/aisim
# Backend-only. Never expose this to the frontend.
ANTHROPIC_API_KEY=
# Resume worlds that were running when the backend stopped.
AISIM_AUTO_RESUME=false
# Comma-separated list of allowed browser origins.
AISIM_CORS_ORIGINS=http://localhost:5173
# Optional bearer token required for mutating API calls.
AISIM_API_TOKEN=
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
