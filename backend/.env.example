# Copy to backend/.env and edit. `python -m aisim` (and ./run.sh) read it automatically.
# Never commit the real file.

# Database. Leave unset to use a local SQLite file (backend/aisim.db) - fine for
# personal use. For PostgreSQL, uncomment and adjust:
# DATABASE_URL=postgresql+psycopg://aisim:aisim@localhost:5432/aisim

# Needed only for Claude-driven agents. Backend-only: never exposed to the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# Restart worlds that were running when the server stopped.
AISIM_AUTO_RESUME=false

# Optional bearer token required for changes through the API.
# AISIM_API_TOKEN=

HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
